<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbyReferenceDir Condition="'$(EmbyReferenceDir)' == ''">$(AppData)\Emby-Server\system</EmbyReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../HomeScreenCompanion/AnimeMappingIndex.cs" Link="AnimeMappingIndex.cs" />
    <Compile Include="../HomeScreenCompanion/AnimeRelations.cs" Link="AnimeRelations.cs" />
    <Compile Include="../HomeScreenCompanion/AnimeGraphExpansion.cs" Link="AnimeGraphExpansion.cs" />
    <Compile Include="../HomeScreenCompanion/AnimeCollectionMembership.cs" Link="AnimeCollectionMembership.cs" />
    <Compile Include="../HomeScreenCompanion/AnimeCollectionPolicy.cs" Link="AnimeCollectionPolicy.cs" />
    <Compile Include="../HomeScreenCompanion/PluginConfiguration.cs" Link="PluginConfiguration.cs" />
    <Compile Include="../HomeScreenCompanion/AiRequestClient.cs" Link="AiRequestClient.cs" />
    <Compile Include="../HomeScreenCompanion/AiResponseDtos.cs" Link="AiResponseDtos.cs" />
    <Compile Include="../HomeScreenCompanion/AiSecretPolicy.cs" Link="AiSecretPolicy.cs" />
    <Compile Include="../HomeScreenCompanion/AnimeAiAnalysisService.cs" Link="AnimeAiAnalysisService.cs" />
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(EmbyReferenceDir)/MediaBrowser.Model.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
</Project>
